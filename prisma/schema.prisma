generator client {
  provider      = "prisma-client-js"
  engineType    = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Plan {
  id         Int           @id @default(autoincrement())
  nombre     String        @unique @db.VarChar(100)
  precio     Int
  push       Boolean       @default(false)
  whatsapp   Boolean       @default(false)
  email      Boolean       @default(true)
  activo     Boolean       @default(true)
  created_at DateTime      @default(now()) @map("created_at")
  pagos      Pago[]
  suscripciones Suscripcion[]
  instituciones Instituciones[]

  @@map("Planes")
}

model Suscripcion {
  id              Int            @id @default(autoincrement())
  email           String         @db.VarChar(255)
  plan_id         Int
  estado          String         @db.VarChar(50)
  fecha_inicio    DateTime?      @map("fecha_inicio")
  fecha_fin       DateTime?      @map("fecha_fin")
  institucion_id  Int?           @unique @map("institucion_id")
  created_at      DateTime       @default(now()) @map("created_at")
  plan            Plan           @relation(fields: [plan_id], references: [id])
  institucion     Instituciones?

  @@map("Suscripciones")
}

model Instituciones {
  id                  Int               @id @default(autoincrement())
  plan_id             Int?              @map("plan_id")
  suscripcion_id      Int?              @unique @map("suscripcion_id")
  push_enabled        Boolean           @default(false)
  nombre              String            @db.VarChar(255)
  direccion_principal String            @db.VarChar(500)
  nit                 String            @db.VarChar(50)
  nombre_contacto     String            @db.VarChar(255)
  telefono_contacto   String            @db.VarChar(20)
  email               String            @unique @db.VarChar(255)
  password            String            @db.VarChar(255)
  logo_url            String?           @db.VarChar(500)
  banner_url          String?           @db.VarChar(500)
  color_primario      String            @default("#2563eb") @db.VarChar(7)
  color_secundario    String            @default("#0f172a") @db.VarChar(7)
  tiene_sedes         Boolean           @default(false)
  jornadas            String[]          @default([])
  created_at          DateTime          @default(now()) @map("created_at")
  updated_at          DateTime          @updatedAt @map("updated_at")
  administradores     Administradores[]
  sedes               Sedes[]
  grados              Grados[]
  cursos              Cursos[]
  areas               Areas[]
  materias            Materias[]
  docentes            Docentes[]
  estudiantes         Estudiantes[]
  acudientes          Acudientes[]
  pushSubscriptions   PushSubscriptions[]
  plan                Plan?             @relation(fields: [plan_id], references: [id])
  suscripcion         Suscripcion?      @relation(fields: [suscripcion_id], references: [id])

  @@map("Instituciones")
}

model Acudientes {
  id               Int                 @id @default(autoincrement())
  institucion_id   Int
  email            String              @db.VarChar(255)
  nombre           String              @db.VarChar(255)
  telefono         String?             @db.VarChar(20)
  created_at       DateTime            @default(now()) @map("created_at")
  institucion      Instituciones       @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  pushSubscriptions PushSubscriptions[]

  @@unique([institucion_id, email])
  @@map("Acudientes")
}

model PushSubscriptions {
  id             Int           @id @default(autoincrement())
  institucion_id Int
  acudiente_id   Int
  endpoint       String        @db.Text
  p256dh        String        @db.VarChar(255)
  auth          String        @db.VarChar(255)
  created_at    DateTime      @default(now()) @map("created_at")
  institucion   Instituciones @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  acudiente     Acudientes    @relation(fields: [acudiente_id], references: [id], onDelete: Cascade)

  @@unique([institucion_id, acudiente_id, endpoint])
  @@map("PushSubscriptions")
}

model Sedes {
  id              Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(255)
  jornadas        String[]          @default([])
  institucion_id  Int
  created_at      DateTime          @default(now()) @map("created_at")
  updated_at      DateTime          @updatedAt @map("updated_at")
  institucion     Instituciones     @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  administradores Administradores[]
  grados          Grados[]
  cursos          Cursos[]
  areas           Areas[]
  materias        Materias[]
  docentes        Docentes[]
  estudiantes     Estudiantes[]

  @@map("Sedes")
}

model Administradores {
  id                Int           @id @default(autoincrement())
  nombre            String        @db.VarChar(255)
  apellido          String        @db.VarChar(255)
  telefono          String        @db.VarChar(20)
  cargo             String        @db.VarChar(100)
  institucion_id    Int
  created_at        DateTime      @default(now()) @map("created_at")
  updated_at        DateTime      @updatedAt @map("updated_at")
  correo            String        @unique @db.VarChar(255)
  sede_id           Int?
  password          String        @db.VarChar(255)
  supabase_user_id  String?       @db.VarChar(255)
  institucion       Instituciones @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede              Sedes?        @relation(fields: [sede_id], references: [id])

  @@map("Administradores")
}

model PasswordResetTokens {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  used      Boolean  @default(false)
  userType  String   @db.VarChar(50) // 'institucion', 'administrador', 'docente'
  createdAt DateTime @default(now()) @map("created_at")

  @@map("PasswordResetTokens")
}

// ========================================
// MODELOS DEL SISTEMA EDUCATIVO
// ========================================

model Grados {
  id             Int             @id @default(autoincrement())
  nombre         String          @db.VarChar(100) // "PÁRVULOS", "1°", "2°", etc.
  nivel          String          @db.VarChar(50) // "Educación Inicial", "Primaria", "Secundaria", "Media"
  orden          Int // Para ordenarlos: 1, 2, 3...
  institucion_id Int
  sede_id        Int?
  created_at     DateTime        @default(now()) @map("created_at")
  updated_at     DateTime        @updatedAt @map("updated_at")
  institucion    Instituciones   @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede           Sedes?          @relation(fields: [sede_id], references: [id])
  cursos         Cursos[]
  estudiantes    Estudiantes[]
  materiaGrados  MateriaGrados[]
  docenteAsignaciones DocenteAsignaciones[]
  recordatorios  Recordatorios[]

  @@map("Grados")
}

model Cursos {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(100) // "Curso A", "Curso B", etc.
  grado_id            Int
  jornada             String?               @db.VarChar(50) // "Mañana", "Tarde", etc.
  sede_id             Int?
  institucion_id      Int
  created_at          DateTime              @default(now()) @map("created_at")
  updated_at          DateTime              @updatedAt @map("updated_at")
  grado               Grados                @relation(fields: [grado_id], references: [id], onDelete: Cascade)
  institucion         Instituciones         @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede                Sedes?                @relation(fields: [sede_id], references: [id])
  estudiantes         Estudiantes[]
  docenteAsignaciones DocenteAsignaciones[]
  recordatorios       Recordatorios[]

  @@map("Cursos")
}

model Areas {
  id             Int           @id @default(autoincrement())
  nombre         String        @db.VarChar(255)
  es_opcional    Boolean       @default(false) // true para las 4 opcionales
  orden          Int
  institucion_id Int
  sede_id        Int?
  activa         Boolean       @default(true) // Para activar/desactivar opcionales
  created_at     DateTime      @default(now()) @map("created_at")
  updated_at     DateTime      @updatedAt @map("updated_at")
  institucion    Instituciones @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede           Sedes?        @relation(fields: [sede_id], references: [id])
  materias       Materias[]
  recordatorios  Recordatorios[]

  @@map("Areas")
}

model Materias {
  id                  Int                   @id @default(autoincrement())
  nombre              String                @db.VarChar(255) // "Biología", "Álgebra", etc.
  area_id             Int
  institucion_id      Int
  sede_id             Int?
  created_at          DateTime              @default(now()) @map("created_at")
  updated_at          DateTime              @updatedAt @map("updated_at")
  area                Areas                 @relation(fields: [area_id], references: [id], onDelete: Cascade)
  institucion         Instituciones         @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede                Sedes?                @relation(fields: [sede_id], references: [id])
  materiaGrados       MateriaGrados[]
  docenteAsignaciones DocenteAsignaciones[]
  recordatorios       Recordatorios[]

  @@map("Materias")
}

model MateriaGrados {
  id         Int      @id @default(autoincrement())
  materia_id Int
  grado_id   Int
  created_at DateTime @default(now()) @map("created_at")
  materia    Materias @relation(fields: [materia_id], references: [id], onDelete: Cascade)
  grado      Grados   @relation(fields: [grado_id], references: [id], onDelete: Cascade)

  @@unique([materia_id, grado_id])
  @@map("MateriaGrados")
}

model Docentes {
  id                  Int                   @id @default(autoincrement())
  apellidos           String                @db.VarChar(255)
  nombres             String                @db.VarChar(255)
  telefono            String                @db.VarChar(20)
  email               String                @unique @db.VarChar(255)
  institucion_id      Int
  sede_id             Int?
  auth_user_id        String?               @db.VarChar(255)
  activo              Boolean               @default(true)
  created_at          DateTime              @default(now()) @map("created_at")
  updated_at          DateTime              @updatedAt @map("updated_at")
  institucion         Instituciones         @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede                Sedes?                @relation(fields: [sede_id], references: [id])
  docenteAsignaciones DocenteAsignaciones[]
  recordatorios       Recordatorios[]

  @@map("Docentes")
}

model DocenteAsignaciones {
  id         Int      @id @default(autoincrement())
  docente_id Int
  grado_id   Int
  curso_id   Int
  materia_id Int
  created_at DateTime @default(now()) @map("created_at")
  docente    Docentes @relation(fields: [docente_id], references: [id], onDelete: Cascade)
  grado      Grados   @relation(fields: [grado_id], references: [id], onDelete: Cascade)
  curso      Cursos   @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  materia    Materias @relation(fields: [materia_id], references: [id], onDelete: Cascade)

  @@unique([docente_id, grado_id, curso_id, materia_id])
  @@map("DocenteAsignaciones")
}

model Estudiantes {
  id                  Int           @id @default(autoincrement())
  apellidos           String        @db.VarChar(255)
  nombres             String        @db.VarChar(255)
  codigo_estudiantil  String        @db.VarChar(50)
  nombre_acudiente    String        @db.VarChar(255)
  correo_acudiente    String?       @db.VarChar(255)
  telefono_acudiente  String        @db.VarChar(20)
  grado_id            Int
  curso_id            Int
  institucion_id      Int
  sede_id             Int?
  activo              Boolean       @default(true)
  created_at          DateTime      @default(now()) @map("created_at")
  updated_at          DateTime      @updatedAt @map("updated_at")
  grado               Grados        @relation(fields: [grado_id], references: [id], onDelete: Cascade)
  curso               Cursos        @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  institucion         Instituciones @relation(fields: [institucion_id], references: [id], onDelete: Cascade)
  sede                Sedes?        @relation(fields: [sede_id], references: [id])
  recordatorioEstudiantes RecordatorioEstudiantes[]

  @@unique([codigo_estudiantil, institucion_id])
  @@map("Estudiantes")
}

model Recordatorios {
  id          Int                     @id @default(autoincrement())
  nombre      String                  @db.VarChar(255)
  descripcion String                  @db.Text
  fecha       DateTime
  tipo        String                  @db.VarChar(50) // 'tarea', 'examen', 'evento', 'otro'
  modo_envio  String?                 @db.VarChar(100) // 'sms', 'whatsapp', 'email' (comma-separated)
  docente_id  Int
  grado_id    Int
  curso_id    Int
  area_id     Int
  materia_id  Int
  created_at  DateTime                @default(now()) @map("created_at")
  updated_at  DateTime                @updatedAt @map("updated_at")
  docente     Docentes                @relation(fields: [docente_id], references: [id], onDelete: Cascade)
  grado       Grados                  @relation(fields: [grado_id], references: [id], onDelete: Cascade)
  curso       Cursos                  @relation(fields: [curso_id], references: [id], onDelete: Cascade)
  area        Areas                   @relation(fields: [area_id], references: [id], onDelete: Cascade)
  materia     Materias                @relation(fields: [materia_id], references: [id], onDelete: Cascade)
  estudiantes RecordatorioEstudiantes[]

  @@map("Recordatorios")
}

model RecordatorioEstudiantes {
  id              Int          @id @default(autoincrement())
  recordatorio_id Int
  estudiante_id   Int
  created_at      DateTime     @default(now()) @map("created_at")
  recordatorio    Recordatorios @relation(fields: [recordatorio_id], references: [id], onDelete: Cascade)
  estudiante      Estudiantes  @relation(fields: [estudiante_id], references: [id], onDelete: Cascade)

  @@unique([recordatorio_id, estudiante_id])
  @@map("RecordatorioEstudiantes")
}

model Pago {
  id              Int      @id @default(autoincrement())
  email           String   @db.VarChar(255)
  referencia      String   @unique @db.VarChar(255)
  mercado_pago_id String?  @unique @map("mercado_pago_id") @db.VarChar(255)
  plan_id         Int      @map("plan_id")
  monto           Int
  estado          String   @db.VarChar(50)
  procesado       Boolean  @default(false)
  datos_preregistro Json?  @map("datos_preregistro")
  created_at      DateTime @default(now()) @map("created_at")
  plan            Plan     @relation(fields: [plan_id], references: [id])

  @@map("Pagos")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  usuario    String?  @db.VarChar(255)
  accion     String   @db.VarChar(100)
  ip         String?  @db.VarChar(64)
  metadata   String?  @db.Text
  created_at DateTime @default(now()) @map("created_at")

  @@map("AuditLogs")
}

/// Respaldo JSONB antes de eliminar una institución (retención limitada).
model InstitutionDeletionArchive {
  id               String   @id @default(uuid()) @db.Uuid
  institucion_id   Int      @map("institucion_id")
  nombre           String   @db.VarChar(255)
  email            String   @db.VarChar(255)
  nit              String?  @db.VarChar(50)
  deleted_by       String   @map("deleted_by") @db.VarChar(255)
  reason           String   @default("user_request") @db.VarChar(50)
  snapshot_version Int      @default(1) @map("snapshot_version")
  snapshot         Json
  auth_user_ids    String[] @default([]) @map("auth_user_ids")
  deleted_at       DateTime @default(now()) @map("deleted_at")
  retention_until  DateTime @map("retention_until")

  @@index([institucion_id])
  @@index([email])
  @@index([deleted_at])
  @@index([retention_until])
  @@map("InstitutionDeletionArchives")
}
