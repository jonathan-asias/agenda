# URL pública de la aplicación (enlaces en correos de confirmación, reset de contraseña, etc.)
# Desarrollo local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Producción: usar la URL real, ej. https://tu-dominio.com

# Correo transaccional (recuperación de contraseña, recordatorios). Si no está, se usa Supabase Auth.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Agenda Virtual <onboarding@resend.dev>

# Base de datos (Prisma). En Vercel + Supabase (Session mode) usar pooler con:
# DATABASE_URL="postgresql://...:...@...supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL para migraciones (conexión directa, puerto 5432, sin pgbouncer).
# DIRECT_URL="postgresql://...:...@...supabase.co:5432/postgres"

# Mercado Pago Checkout Pro (https://www.mercadopago.com.co/developers)
# Credenciales de PRUEBA pueden ser TEST- o APP_USR- (panel "Credenciales de prueba").
# MERCADOPAGO_SANDBOX=true fuerza checkout sandbox (sandbox_init_point).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SANDBOX=true
# Desarrollo local: simula pago sin abrir sandbox.mercadopago.com.co (solo con SANDBOX=true, no producción)
# MERCADOPAGO_DEV_MOCK_CHECKOUT=true
# Secreto de firma de webhooks (Tus integraciones > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública del servidor (webhooks, correos). En desarrollo local use localhost:
APP_URL=http://localhost:3000
# Producción / Vercel: https://tu-dominio.vercel.app
# Enlace alternativo localhost en correo post-pago (solo si APP_URL no es localhost)
# LOCAL_REGISTRATION_URL=http://localhost:3000
# Inicialización de planes: POST /api/planes/init con header x-plans-init-secret
PLANS_INIT_SECRET=
# SKIP_PAYMENT_FOR_REGISTRATION=true
# Días de acceso solo lectura tras cancelar suscripción (default: 7)
SUBSCRIPTION_GRACE_DAYS=7
# Retención del respaldo JSONB al eliminar cuenta (default: 90 días)
INSTITUTION_ARCHIVE_RETENTION_DAYS=90
# Correos con acceso al panel de gestión interna (/gestion-vortico/acceso), separados por coma
PLATFORM_ADMIN_EMAILS=
# Vigencia del enlace de invitación a versión de prueba (horas). Default: 24
# TRIAL_LINK_TTL_HOURS=24
# Duración de la prueba al registrarse con invitación (días). Default: 30
# TRIAL_DAYS_DEFAULT=30

# Wompi (https://docs.wompi.co) — Colombia
# Llaves en Dashboard > Desarrolladores. Sandbox: pub_test_ / prv_test_
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# Secreto de integridad (Checkout Web / firma de transacción)
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos (webhook transaction.updated) — prefijo test_events_ en sandbox
WOMPI_EVENTS_SECRET=
WOMPI_SANDBOX=true

# Confirmación manual de compra (solo pruebas). Generar token largo y abrir /prueba/confirmar-compra/<token>
# PAYMENT_DEV_CONFIRM_SECRET=
# PAYMENT_DEV_CONFIRM_ENABLED=false  # opcional: desactiva la ruta aunque haya secret y sandbox

# Cloudflare Turnstile (verificación anti-bot)
# Crear widget en https://dash.cloudflare.com/ → Turnstile
# Dominios: localhost y tu dominio de producción
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Firma HMAC para enlaces de activación push en correos
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUSH_ACTIVATION_SECRET=
# Enlace firmado post-pago (registro institución). Opcional: usa PUSH_ACTIVATION_SECRET si falta.
# REGISTRO_ACCESS_SECRET=
# REGISTRO_ACCESS_TTL_HOURS=48

# RLS: DATABASE_URL = postgres pooler (bypass/sistema). DATABASE_URL_AGENDA_APP = rol agenda_app.
# En pooler el usuario debe llevar project ref: agenda_app.TU_REF (o usa db.*.supabase.co:5432 directo).
# DATABASE_URL="postgresql://postgres.TU_REF:PASSWORD@...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DATABASE_URL_AGENDA_APP="postgresql://agenda_app.TU_REF:PASSWORD@...pooler.supabase.com:6543/postgres?pgbouncer=true"

# Storage: aplicar políticas en supabase/storage-policies.sql (Dashboard > SQL Editor)
# MIME types branding + sílabus: node scripts/apply-storage-silabus-mimes.mjs
# (o scripts/migrations/update-storage-bucket-silabus-mimes.sql en SQL Editor)
