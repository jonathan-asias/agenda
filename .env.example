# URL pública de la aplicación (enlaces en correos de confirmación, reset de contraseña, etc.)
# Desarrollo local:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Producción: usar la URL real, ej. https://tu-dominio.com

# Base de datos (Prisma). En Vercel + Supabase (Session mode) usar pooler con:
# DATABASE_URL="postgresql://...:...@...supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL para migraciones (conexión directa, puerto 5432, sin pgbouncer).
# DIRECT_URL="postgresql://...:...@...supabase.co:5432/postgres"
