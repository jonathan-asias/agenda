E2E_GV_PASSWORD=

# Misma contraseña para todas las cuentas de prueba
E2E_PASSWORD=

# Prefijo Gmail +alias
E2E_EMAIL_BASE=jonathanasias

# Plan Básico (solo email). Si se omite, el script elige el plan sin whatsapp.
# E2E_PLAN_ID=
